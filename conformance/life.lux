// life — Conway's Game of Life, as a pure function from one world to the next.
//
//   lux run life.lux
//
// There are no 2-D arrays here and no mutation. The board is one flat row of
// cells plus a width, and `y * w + x` is the whole trick — the same index math
// a graphics buffer uses. Each generation is a brand new board, which is not a
// workaround for lux's immutability but the way this algorithm actually wants
// to be written: you must read every neighbour from the OLD world, so editing
// in place would be a bug.

struct Board {
    w: int
    h: int
    cells: [bool]
}

// Off the edge counts as dead, so the board doesn't wrap.
func at(b: Board, x: int, y: int) -> bool {
    if x < 0 || y < 0 || x >= b.w || y >= b.h {
        return false
    }
    return b.cells[y * b.w + x]
}

func score(alive: bool) -> int {
    if alive {
        return 1
    }
    return 0
}

func neighbours(b: Board, x: int, y: int) -> int {
    var n = 0
    for dy in 0..3 {
        for dx in 0..3 {
            if !(dx == 1 && dy == 1) {
                n += score(at(b, x + dx - 1, y + dy - 1))
            }
        }
    }
    return n
}

// The rules, stated once: three neighbours is birth, two keeps you alive.
func nextCell(alive: bool, n: int) -> bool {
    if n == 3 {
        return true
    }
    return alive && n == 2
}

func step(b: Board) -> Board {
    var out: [bool] = []
    for y in 0..b.h {
        for x in 0..b.w {
            out += nextCell(at(b, x, y), neighbours(b, x, y))
        }
    }
    return Board(w: b.w, h: b.h, cells: out)
}

func glyph(alive: bool) -> string {
    if alive {
        return "#"
    }
    return "."
}

func render(b: Board) -> string {
    var picture = ""
    for y in 0..b.h {
        var row = ""
        for x in 0..b.w {
            row = row + glyph(at(b, x, y))
        }
        picture = picture + row + "\n"
    }
    return picture
}

func population(b: Board) -> int {
    var n = 0
    for c in b.cells {
        n += score(c)
    }
    return n
}

// A glider, drawn as text so the starting world is readable in the source.
//   .#........
//   ..#.......
//   ###.......
func seed(w: int, h: int) -> Board {
    let live = [1, 12, 20, 21, 22]
    var cells: [bool] = []
    for i in 0..(w * h) {
        var on = false
        for spot in live {
            if spot == i {
                on = true
            }
        }
        cells += on
    }
    return Board(w: w, h: h, cells: cells)
}

var world = seed(10, 8)
for gen in 0..5 {
    print("generation " + string(gen) + " — population " + string(population(world)))
    print(render(world))
    world = step(world)
}
