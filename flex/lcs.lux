// lcs — the longest common subsequence, and a grid used as memory.
//
//   lux run lcs.lux
//
// Two sequences, and the question is how much of one survives inside the other if
// you may delete but never reorder. Written the obvious recursive way it re-asks the
// same question exponentially many times. The fix is a grid: `table[i][j]` holds the
// answer for the first `i` of one and the first `j` of the other, every cell is
// filled from cells already filled, and each subproblem is solved exactly once.
//
// That trade — space for time, a table standing in for repeated work — is the whole
// of dynamic programming, and this is the smallest honest example of it.
//
// The textbook version runs on two strings. lux cannot index a string, so these are
// rows of numbers instead. The algorithm is unchanged; only the alphabet is.

func filled(r: int, c: int) -> [[int]] {
    var out: [[int]] = []
    for _ in 0..r {
        var row: [int] = []
        for _ in 0..c {
            row += 0
        }
        out += row
    }
    return out
}

func bigger(a: int, b: int) -> int {
    if a > b {
        return a
    }
    return b
}

// One extra row and column of zeros along the top and left, standing for "nothing
// of this sequence yet" — which is what makes every other cell able to look back
// without asking whether it is on an edge.
func build(a: [int], b: [int]) -> [[int]] {
    var table = filled(length(a) + 1, length(b) + 1)
    for i in 1..(length(a) + 1) {
        for j in 1..(length(b) + 1) {
            let above = table[i - 1]
            if a[i - 1] == b[j - 1] {
                // The values match, so extend the answer from the corner.
                table[i][j] = above[j - 1] + 1
            } else {
                // They don't, so keep the better of dropping one from either side.
                let here = table[i]
                table[i][j] = bigger(above[j], here[j - 1])
            }
        }
    }
    return table
}

// The table holds the length. The sequence itself is recovered by walking back from
// the corner, which is the part most explanations skip.
func recover(table: [[int]], a: [int], b: [int]) -> [int] {
    var out: [int] = []
    var i = length(a)
    var j = length(b)
    while i > 0 && j > 0 {
        let here = table[i]
        let above = table[i - 1]
        if a[i - 1] == b[j - 1] {
            out += a[i - 1]
            i -= 1
            j -= 1
        } else if above[j] >= here[j - 1] {
            i -= 1
        } else {
            j -= 1
        }
    }
    return reversed(out)
}

func reversed(xs: [int]) -> [int] {
    var out: [int] = []
    var i = length(xs) - 1
    while i >= 0 {
        out += xs[i]
        i -= 1
    }
    return out
}

func draw(table: [[int]], a: [int], b: [int]) {
    var header = "      "
    for v in b {
        header = header + pad(v) + " "
    }
    print(header)
    for i in 0..length(table) {
        var line = ""
        if i == 0 {
            line = "   "
        } else {
            line = pad(a[i - 1]) + " "
        }
        line = line + " "
        for n in table[i] {
            line = line + pad(n) + " "
        }
        print(line)
    }
}

func pad(n: int) -> string {
    var s = string(n)
    while length(s) < 2 {
        s = " " + s
    }
    return s
}

let a = [1, 3, 4, 1, 2, 3, 4, 1]
let b = [3, 4, 1, 2, 1, 3]

let table = build(a, b)
draw(table, a, b)

print("")
print("a       ", a)
print("b       ", b)
let corner = table[length(a)]
print("longest ", corner[length(b)])
print("which is", recover(table, a, b))

print("")
// Two sequences with nothing in common still have an answer, and it is zero rather
// than a special case anyone had to write.
let disjoint = build([1, 2, 3], [4, 5, 6])
let disjointCorner = disjoint[3]
print("nothing in common:", disjointCorner[3])
let identical = build([7, 7, 7], [7, 7, 7])
let identicalCorner = identical[3]
print("identical:        ", identicalCorner[3])
